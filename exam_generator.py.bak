"""Exam generation module for GCSE AI.

Contains ExamStructureBuilder for creating exam structures from past paper patterns,
and QuestionGenerator for generating individual questions and full exams.
"""

import logging
import random
from typing import Any, Optional

from langchain.chains import RetrievalQA

from config import SubjectConfig
from llm_client import LLMClient
from similarity import SimilarityEngine

logger = logging.getLogger(__name__)

MAX_STRUCTURE_RETRIES = 50


class ExamStructureBuilder:
    """Builds exam structures based on patterns from past papers.

    Analyses historical question papers to determine typical mark distributions
    and creates new exam structures that follow similar patterns.
    """

    def __init__(
        self,
        config: SubjectConfig,
        questions: list[dict],
    ):
        self.config = config
        self.questions = questions

    @staticmethod
    def flatten_marks(marks: Any) -> int:
        """Flatten a potentially nested mark structure into a total mark count.

        Args:
            marks: An int, or a list of ints/lists representing sub-question marks.

        Returns:
            Total marks as an integer.
        """
        if isinstance(marks, int):
            return marks
        if not isinstance(marks, list):
            return marks
        total = 0
        for item in marks:
            if isinstance(item, list):
                for sub_item in item:
                    if isinstance(sub_item, int):
                        total += sub_item
            elif isinstance(item, int):
                total += item
        return total

    def get_past_exam_structures(self, topic: str) -> list[list[list]]:
        """Extract mark structures from past exams for a given topic.

        Args:
            topic: The exam topic to filter questions by.

        Returns:
            A list of exams, where each exam is a list of [marks, type] pairs.
        """
        current_exam = ""
        exam_marks: list[list] = []
        all_exams: list[list[list]] = []

        for question in self.questions:
            is_relevant = (
                question["topic"] == topic
                and question["type"] in ("parent_question", "basic_question")
            )
            if not is_relevant:
                continue

            if question["exam"] != current_exam:
                if exam_marks:
                    all_exams.append(exam_marks)
                exam_marks = []
                current_exam = question["exam"]

            if question["type"] == "parent_question":
                marks = [self.flatten_marks(question["parent_question_structure"]), "parent"]
            else:
                marks = [question["marks"], "basic"]
            exam_marks.append(marks)

        if exam_marks:
            all_exams.append(exam_marks)

        return all_exams

    def build_structure(self, total_marks: int, topic: str) -> list:
        """Build an exam structure that totals the given marks.

        Uses patterns from past papers to create a realistic exam structure.
        Retries up to MAX_STRUCTURE_RETRIES times if the structure cannot be resolved.

        Args:
            total_marks: Target total marks for the exam.
            topic: The exam topic for retrieving past structures.

        Returns:
            A list of mark structures (ints or nested lists for parent questions).

        Raises:
            RuntimeError: If a valid structure cannot be built within the retry limit.
        """
        past_structures = self.get_past_exam_structures(topic)
        if not past_structures:
            raise ValueError(f"No past exam structures found for topic: {topic}")

        avg_marks = sum(m[0] for m in past_structures[0]) / len(past_structures[0])
        n_questions = round(total_marks / avg_marks)

        for retry in range(MAX_STRUCTURE_RETRIES):
            try:
                structure = self._attempt_build(
                    total_marks, n_questions, past_structures, topic
                )
                if structure is not None:
                    logger.info("Exam structure built successfully on attempt %d", retry + 1)
                    return structure
            except (IndexError, ValueError) as e:
                logger.debug("Structure attempt %d failed: %s", retry + 1, e)

        raise RuntimeError(
            f"Could not build valid exam structure after {MAX_STRUCTURE_RETRIES} attempts "
            f"for {total_marks} marks on topic '{topic}'"
        )

    def _attempt_build(
        self,
        total_marks: int,
        n_questions: int,
        past_structures: list[list[list]],
        topic: str,
    ) -> Optional[list]:
        """Single attempt to build an exam structure.

        Returns:
            The completed structure, or None if this attempt failed.
        """
        exam_structure = []
        last_type = ""
        marks_left = total_marks

        for i in range(n_questions):
            possible_marks = []
            for exam in past_structures:
                if i < len(exam):
                    possible_marks.append(exam[i])

            valid_marks = [m for m in possible_marks if m[0] <= marks_left]
            if valid_marks:
                chosen = random.choice(valid_marks)
            else:
                chosen = [0, last_type]

            exam_structure.append(chosen)
            marks_left -= chosen[0]
            last_type = chosen[1]

        # Distribute remaining marks to the last question
        if marks_left != 0 and exam_structure:
            exam_structure[-1][0] += marks_left

        # Resolve parent question structures
        return self._resolve_structures(exam_structure, past_structures, topic)

    def _resolve_structures(
        self,
        exam_structure: list[list],
        past_structures: list[list[list]],
        topic: str,
    ) -> Optional[list]:
        """Resolve abstract mark allocations into concrete question structures.

        For parent questions, finds matching structures from past papers.
        """
        final_structure = []
        question_number = 0
        last_exam = ""

        for question in exam_structure:
            marks = question[0]
            question_type = question[1]

            if question_type == "parent":
                possible_structures = []
                q_counter = 0

                for q in self.questions:
                    if q["type"] not in ("parent_question", "basic_question"):
                        continue
                    q_counter += 1
                    if q["exam"] != last_exam:
                        last_exam = q["exam"]
                        q_counter = 0

                    matches_marks = (
                        q["type"] == "parent_question" 
                        and q.get("parent_question_structure") is not None
                        and self.flatten_marks(q["parent_question_structure"]) == marks
                    )
                    matches_topic = q["topic"] == topic
                    matches_position = (
                        q_counter == exam_structure.index(question)
                        or not self.config.question_no_importance
                    )

                    if matches_marks and matches_topic and matches_position:
                        possible_structures.append(q["parent_question_structure"])

                if not possible_structures:
                    return None  # Signal retry needed

                marks = random.choice(possible_structures)
                question_number += 1

            final_structure.append(marks)

        return final_structure

    @staticmethod
    def distribute_to_topics(
        base_structure: list, topics: list[str]
    ) -> dict[str, list]:
        """Distribute an exam structure evenly across topics.

        Args:
            base_structure: The overall exam structure (list of mark allocations).
            topics: List of topic names to distribute across.

        Returns:
            Dict mapping topic names to their allocated structure portions.
        """
        n = len(base_structure)
        k = len(topics)
        if k == 0:
            raise ValueError("At least one topic is required")

        chunk_size = n // k
        remainder = n % k

        result = {}
        start = 0
        for i, topic in enumerate(topics):
            end = start + chunk_size + (1 if i < remainder else 0)
            result[topic] = base_structure[start:end]
            start = end

        return result


class QuestionGenerator:
    """Generates GCSE exam questions using LLM and past paper patterns.

    Uses specification content, past paper examples, and semantic similarity
    to create new questions that match the style and difficulty of real exams.
    """

    def __init__(
        self,
        config: SubjectConfig,
        llm_client: LLMClient,
        similarity_engine: SimilarityEngine,
        questions: list[dict],
        prompts: dict[str, str],
        queries: dict[str, str],
        spec_qa_chain: RetrievalQA,
        ms_retriever: Any = None,
    ):
        self.config = config
        self.llm = llm_client
        self.similarity = similarity_engine
        self.questions = questions
        self.prompts = prompts
        self.queries = queries
        self.spec_qa_chain = spec_qa_chain

    def get_subtopics(self, question_topic: str) -> list[str]:
        """Get specification subtopics for a question topic.

        Args:
            question_topic: The topic to get subtopics for.

        Returns:
            A list of subtopic strings.
        """
        spec_result = self._get_specification_result(question_topic)
        return self._format_spec_subtopics(spec_result)

    def _get_specification_result(self, question_topic: str) -> str:
        """Query the specification vector store for topic information."""
        query = self.queries["get_topic_info"].format(
            question_topic=question_topic
        )
        return self.llm.invoke_qa(self.spec_qa_chain, query)

    def _format_spec_subtopics(self, specification_result: str) -> list[str]:
        """Format raw specification result into a list of subtopics."""
        prompt = self.prompts["format_subtopics_from_spec"].format(
            specification_result=specification_result
        )
        return self.llm.invoke_json(prompt)

    def get_subtopic_info(self, subtopic: str, topic: str) -> str:
        """Get detailed information about a subtopic from the spec."""
        query = self.queries["get_subtopic_info"].format(
            topic=topic, subtopic=subtopic
        )
        return self.llm.invoke_qa(self.spec_qa_chain, query)

    def get_subsubtopic_info(
        self, subsubtopic: str, subtopic: str, topic: str
    ) -> str:
        """Get detailed information about a sub-subtopic from the spec."""
        query = self.queries["get_subsubtopic_info"].format(
            topic=topic, subtopic=subtopic, subsubtopic=subsubtopic
        )
        return self.llm.invoke_qa(self.spec_qa_chain, query)

    def generate_question(
        self,
        marks: int,
        exam_topic: str,
        subtopic: str,
        subtopic_info: str,
        question_content: str = "",
        parent_description: str = "",
    ) -> str:
        """Generate a single exam question.

        Args:
            marks: Number of marks for the question.
            exam_topic: The broad exam topic.
            subtopic: The specific subtopic being tested.
            subtopic_info: Specification information about the subtopic.
            question_content: Prior question content for context (multi-part questions).
            parent_description: Parent question description for context.

        Returns:
            The generated question text.
        """
        example_questions = self.similarity.find_least_similar_objects(
            objects=self.questions,
            comparison=subtopic,
            n=self.config.example_questions,
            topic_value=exam_topic,
            marks_value=marks,
        )

        prompt_extension = ""
        if question_content:
            prompt_extension = self.prompts["question_prompt_extention"].format(
                question_content=question_content,
                parent_description=parent_description,
            )

        prompt = self.prompts["make_question"].format(
            subject=self.config.mark_pattern.split("-")[0] if hasattr(self.config, 'subject') else "",
            examiner="",
            marks=marks,
            random_questions=example_questions,
            topic_info=subtopic_info,
            subtopic=subtopic,
        )
        if prompt_extension:
            prompt += "\n" + prompt_extension

        return self.llm.invoke(prompt)

    def choose_relevant_parent_description(self, subtopic_info: str) -> str:
        """Find the most relevant parent question description for a subtopic.

        Uses semantic similarity to match against existing parent descriptions.
        """
        parent_questions = [
            q for q in self.questions if q["type"] == "parent_question"
        ]
        if not parent_questions:
            return ""

        descriptions = [q["parent_question_description"] for q in parent_questions]
        return self.similarity.find_most_similar(subtopic_info, descriptions)

    def make_parent_description(
        self,
        subtopic: str,
        exam_topic: str,
        subtopic_info: str,
        question_content: str = "",
        parent_description: str = "",
    ) -> str:
        """Generate a parent question description/context.

        Creates the introductory text that precedes sub-questions in a
        multi-part question.
        """
        valid_descriptions = [
            q for q in self.questions
            if q["type"] == "parent_question" and q["topic"] == exam_topic
        ]

        n = self.config.example_descriptions
        if n == 0:
            n = 5  # fallback default

        # Use similarity to find closest descriptions
        descriptions_text = [d["parent_question_description"] for d in valid_descriptions]
        contents = [d["question_content"] for d in valid_descriptions]

        if descriptions_text:
            scores = self.similarity.compute_similarity_scores(descriptions_text, [subtopic])
            # Take the n most similar
            close_contents = []
            for desc_text, score in scores[:n]:
                idx = descriptions_text.index(desc_text)
                close_contents.append(contents[idx])
        else:
            close_contents = []

        prompt_extension = ""
        if question_content:
            prompt_extension = self.prompts["question_prompt_extention"].format(
                question_content=question_content,
                parent_description=parent_description,
            )

        # Clean up example descriptions
        clean_prompt = self.prompts["extract_relevant_text"].format(
            random_questions=close_contents,
        )
        if prompt_extension:
            clean_prompt += "\n" + prompt_extension
        cleaned_descriptions = self.llm.invoke(clean_prompt)

        # Generate the description
        prompt = self.prompts["make_parent_description"].format(
            random_questions=cleaned_descriptions,
            subtopic=subtopic,
            subtopic_info=subtopic_info,
        )
        return self.llm.invoke(prompt)

    def adapt_question(
        self,
        marks: int,
        exam_topic: str,
        subtopic: str,
        subtopic_info: str,
        question_content: str = "",
        parent_description: str = "",
    ) -> str:
        """Adapt an existing question to a different subtopic.

        Takes the structure of an example question and modifies it for a new topic.
        """
        prompt_extension = ""
        if question_content:
            prompt_extension = self.prompts["question_prompt_extention"].format(
                question_content=question_content,
                parent_description=parent_description,
            )

        example_questions = self.similarity.find_least_similar_objects(
            objects=self.questions,
            comparison=subtopic,
            n=self.config.example_questions,
            topic_value=exam_topic,
            marks_value=marks,
        )

        prompt = self.prompts["adapt_question"].format(
            subject="",
            subtopic_info=subtopic_info,
            example_question=example_questions,
            subtopic=subtopic,
        )
        if prompt_extension:
            prompt += "\n\n" + prompt_extension

        return self.llm.invoke(prompt)

    def improve_question_coherence(self, question_content: str, subject: str) -> str:
        """Improve the coherence and readability of a generated question."""
        prompt = self.prompts["improve_question_coherance"].format(
            subject=subject,
            question_content=question_content,
        )
        return self.llm.invoke(prompt)

    def generate_exam(
        self,
        exam_topic: str,
        total_marks: int,
        topics: list[str],
        subject: str,
        structure_builder: ExamStructureBuilder,
    ) -> dict[str, Any]:
        """Generate a complete exam with questions across multiple topics.

        Args:
            exam_topic: The broad exam category (e.g., "Higher").
            total_marks: Total marks for the exam.
            topics: List of topic areas to cover.
            subject: The subject name.
            structure_builder: An ExamStructureBuilder instance.

        Returns:
            Dict containing the exam structure and generated questions.
        """
        raw_structure = structure_builder.build_structure(total_marks, exam_topic)
        exam_structure = structure_builder.distribute_to_topics(raw_structure, topics)
        logger.info("Exam structure: %s", exam_structure)

        letters = "abcdefghijklmno"
        romans = ["i", "ii", "iii", "iv", "v"]
        exam_output: dict[str, Any] = {"structure": exam_structure, "questions": {}}

        for topic in exam_structure:
            subtopics = self.get_subtopics(f"{exam_topic} {topic}")
            logger.info("Subtopics for %s: %s", topic, subtopics)

            used_subtopics: list[str] = []
            topic_questions: list[dict] = []
            question_number = 0

            for mark in exam_structure[topic]:
                question_number += 1
                total_mark = ExamStructureBuilder.flatten_marks(mark)
                logger.info("Question %d: %d marks", question_number, total_mark)

                # Pick a subtopic that's different from ones already used
                if not used_subtopics:
                    subtopic = random.choice(subtopics)
                else:
                    subtopic = self.similarity.pick_least_similar(subtopics, used_subtopics)

                if subtopic in subtopics:
                    subtopics.remove(subtopic)
                used_subtopics.append(subtopic)

                subtopic_info = self.get_subtopic_info(subtopic, topic)
                logger.info("Subtopic: %s", subtopic)

                if isinstance(mark, int):
                    # Simple question
                    question_text = self.generate_question(
                        mark, exam_topic, subtopic, subtopic_info
                    )
                    question_entry = {
                        "number": f"{question_number})",
                        "text": question_text,
                        "marks": mark,
                        "subtopic": subtopic,
                    }
                    topic_questions.append(question_entry)
                    logger.info("%d) %s [%d marks]", question_number, question_text, mark)
                else:
                    # Parent question with sub-parts
                    parent_desc = self.choose_relevant_parent_description(subtopic)
                    question_content = parent_desc + "\n\n"
                    logger.info("%d) %s", question_number, parent_desc)

                    subsubtopics = self._format_spec_subtopics(subtopic_info)
                    used_subsubtopics: list[str] = []
                    sub_questions: list[dict] = []

                    for part_idx, sub_mark in enumerate(mark):
                        if len(used_subsubtopics) < 2:
                            subsubtopic = random.choice(subsubtopics)
                        else:
                            subsubtopic = self.similarity.pick_least_similar(
                                subsubtopics, used_subsubtopics
                            )

                        if subsubtopic in subsubtopics:
                            subsubtopics.remove(subsubtopic)
                        used_subsubtopics.append(subsubtopic)
                        subsubtopic_info = self.get_subsubtopic_info(
                            subsubtopic, subtopic, topic
                        )
                        logger.info("Subsubtopic: %s", subsubtopic)

                        if isinstance(sub_mark, int):
                            question = self.generate_question(
                                sub_mark, exam_topic, subsubtopic,
                                subsubtopic_info, question_content, parent_desc,
                            )
                            new_content = f"{question} [{sub_mark} marks]\n\n"
                            question_content += new_content
                            sub_questions.append({
                                "label": f"{letters[part_idx]})",
                                "text": question,
                                "marks": sub_mark,
                            })
                            logger.info("%s) %s [%d marks]", letters[part_idx], question, sub_mark)
                        else:
                            # Sub-parent question with roman numeral parts
                            if part_idx != 0:
                                child_parent_desc = self.make_parent_description(
                                    subsubtopic, exam_topic, subsubtopic_info,
                                    question_content, parent_desc,
                                )
                                new_content = child_parent_desc + "\n\n"
                                subsubtopic_info = subtopic_info
                            else:
                                child_parent_desc = parent_desc
                                new_content = "\n\n"

                            question_content += new_content
                            roman_questions: list[dict] = []

                            for roman_idx, roman_mark in enumerate(sub_mark):
                                description = f"{parent_desc}\n{child_parent_desc}"
                                question = self.generate_question(
                                    roman_mark, exam_topic, subsubtopic,
                                    subsubtopic_info, question_content, description,
                                )
                                new_content = f"{question} [{roman_mark} marks]\n\n"
                                question_content += new_content
                                roman_questions.append({
                                    "label": f"{romans[roman_idx]})",
                                    "text": question,
                                    "marks": roman_mark,
                                })
                                logger.info(
                                    "%s) %s [%d marks]",
                                    romans[roman_idx], question, roman_mark,
                                )

                            sub_questions.append({
                                "label": f"{letters[part_idx]})",
                                "context": child_parent_desc,
                                "sub_parts": roman_questions,
                            })

                    topic_questions.append({
                        "number": f"{question_number})",
                        "parent_description": parent_desc,
                        "sub_questions": sub_questions,
                        "subtopic": subtopic,
                    })

            exam_output["questions"][topic] = topic_questions

        return exam_output

    def get_topics_from_user_input(self, user_input: str) -> str:
        """Extract topic names from free-text user input."""
        prompt = self.prompts["get_topics_from_user"].format(
            user_input=user_input
        )
        return self.llm.invoke(prompt)

    def get_revision_materials(
        self, topic: str, subject: str, spec_qa_chain: RetrievalQA
    ) -> str:
        """Generate revision materials for a topic."""
        query = self.queries["revision_materials"].format(
            topic=topic, subject=subject
        )
        return self.llm.invoke_qa(spec_qa_chain, query)
